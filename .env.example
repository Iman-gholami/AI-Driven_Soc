# Application
NODE_ENV=production
PORT=8000
LOG_LEVEL=info
AIR_GAPPED=false
MONGODB_URI=mongodb://localhost:27017/ai-driven-soc

# SOC analytics semantics
SOC_TIMEZONE=Asia/Tehran
SOC_WEEK_START=saturday

# Panel authentication
# Test-only credentials below are intentionally obvious. Change all three values before deployment.
AUTH_ENABLED=true
AUTH_USERNAME=soc_admin
AUTH_PASSWORD=ChangeMe!123
AUTH_DISPLAY_NAME=SOC Administrator
AUTH_ROLE=admin
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret-before-production
AUTH_TOKEN_TTL_SECONDS=28800
AUTH_REMEMBER_TOKEN_TTL_SECONDS=604800
# Optional static OTP for lab/testing only. Leave blank to disable OTP validation.
AUTH_OTP=

# LLM: current development/testing provider
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_TIMEOUT_MS=5000

# Future air-gapped local OpenAI-compatible endpoint
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=local
LOCAL_LLM_MODEL=
LOCAL_LLM_TIMEOUT_MS=15000
LOCAL_LLM_JSON_MODE=false

# Local intelligence files
IPINFO_MMDB_PATH=
IP_ASSET_DATASET_PATH=
THREAT_INTEL_DATASET_PATH=
THREAT_INTEL_EVIDENCE_LIMIT=12
MITRE_ATTACK_PATH=

# Local historical security reports
# Expected layout: REPORTS_ROOT/1404/*.docx
REPORTS_ROOT=reports
REPORT_IMPORT_MAX_FILE_BYTES=26214400

# Runtime limits
MONGODB_MAX_RETRIES=3
MONGODB_RETRY_DELAY_MS=500
MONGODB_SERVER_SELECTION_TIMEOUT_MS=2000
MAX_RAW_LOG_CHARS=4000
MAX_PAYLOAD_SIZE_BYTES=200000
ENABLE_RATE_LIMITING=true
