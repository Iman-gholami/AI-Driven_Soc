{
  "name": "ai-driven-soc",
  "version": "1.0.0",
  "description": "Real-Time SOC Incident Analysis API for Splunk (Node.js)",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/main.js",
    "dev": "node --watch src/main.js",
    "test": "node --test",
    "lint": "eslint .",
    "import:rules": "node scripts/import-rules.js",
    "panel:install": "npm --prefix panel-ui install",
    "panel:build": "npm --prefix panel-ui run build",
    "import:mitre": "node scripts/import-mitre.js",
    "mitre:coverage": "node scripts/rebuild-mitre-coverage.js",
    "mitre:profile": "node scripts/profile-unmapped-mitre.js",
    "mitre:curated:preview": "node scripts/curate-mitre-mappings.js",
    "mitre:curated:apply": "node scripts/curate-mitre-mappings.js --apply",
    "mitre:gaps:preview": "node scripts/profile-mitre-gaps.js",
    "mitre:gaps:apply": "node scripts/apply-mitre-gaps.js",
    "import:ip-assets": "node scripts/import-ip-assets.js",
    "import:threat-intel": "node scripts/import-threat-intel.js",
    "import:reports": "node scripts/import-reports.js",
    "reconcile:reports": "node scripts/reconcile-reports.js",
    "migrate:report-text-index": "node scripts/migrate-report-text-index.js",
    "profile:report-unknowns": "node scripts/profile-report-unknowns.js",
    "profile:report-targets": "node scripts/profile-report-target-scopes.js",
    "profile:report-table-layouts": "node scripts/profile-report-table-layouts.js",
    "demo:historical-alert": "node scripts/create-historical-context-demo-alert.js",
    "mcp:serve": "node src/mcp/stdio.js",
    "copilot:smoke": "node scripts/copilot-smoke.js",
    "copilot:ask": "node scripts/copilot-ask.js",
    "copilot:investigation-smoke": "node scripts/copilot-investigation-smoke.js",
    "copilot:backfill-event-time": "node scripts/backfill-alert-event-time.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "maxmind": "^5.0.7",
    "mongoose": "^8.16.0",
    "multer": "^2.3.0",
    "openai": "^4.104.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0"
  }
}
