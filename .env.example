# Application
NODE_ENV=production
PORT=8000
LOG_LEVEL=info
AIR_GAPPED=false
MONGODB_URI=mongodb://localhost:27017/ai-driven-soc

# LLM: current development/testing provider
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_TIMEOUT_MS=5000

# Future air-gapped local OpenAI-compatible endpoint
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=local
LOCAL_LLM_MODEL=
LOCAL_LLM_TIMEOUT_MS=15000
LOCAL_LLM_JSON_MODE=false

# Local intelligence files
IPINFO_MMDB_PATH=
IP_ASSET_DATASET_PATH=
THREAT_INTEL_DATASET_PATH=
THREAT_INTEL_EVIDENCE_LIMIT=12
MITRE_ATTACK_PATH=

# Runtime limits
MONGODB_MAX_RETRIES=3
MONGODB_RETRY_DELAY_MS=500
MONGODB_SERVER_SELECTION_TIMEOUT_MS=2000
MAX_RAW_LOG_CHARS=4000
MAX_PAYLOAD_SIZE_BYTES=200000
ENABLE_RATE_LIMITING=true
